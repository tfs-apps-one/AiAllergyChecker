<?xml version="1.0" encoding="utf-8"?>
<!--
    Root: vertical LinearLayout split into two zones:
      - Top 2/3  → AR Camera (PreviewView + CustomOverlayView + Disclaimer)
      - Bottom 1/3 → Allergen Dashboard (3×3 GridLayout, populated from Java)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  TOP 2/3 — Live AR Camera View                             -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2">

        <!-- CameraX preview surface -->
        <androidx.camera.view.PreviewView
            android:id="@+id/preview_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Transparent overlay: draws red bounding boxes over allergen text -->
        <tfsapps.aiallergychecker.CustomOverlayView
            android:id="@+id/overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Always-on disclaimer bar pinned to the top of the camera view -->
        <TextView
            android:id="@+id/disclaimer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#BB000000"
            android:padding="8dp"
            android:text="【注意】本アプリは補助ツールです。アレルギー物質は必ずご自身で目視確認してください。利用によるいかなる被害も開発者は一切責任を負いません。"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.2" />

    </FrameLayout>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  BOTTOM 1/3 — Allergen Dashboard (3 × 3 = 9 allergens)    -->
    <!--  Allergen card Views are added programmatically in         -->
    <!--  MainActivity.buildAllergenCards() to keep this lean.      -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <GridLayout
        android:id="@+id/dashboard_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1A1A1A"
        android:rowCount="3"
        android:columnCount="3"
        android:padding="6dp" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--  BOTTOM — AdMob アンカー型アダプティブバナー                  -->
    <!--  カメラ/グリッドには重ねず、独立した行として配置。             -->
    <!--  AdView は MainActivity.loadBannerAd() で追加する。          -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/black" />

</LinearLayout>
